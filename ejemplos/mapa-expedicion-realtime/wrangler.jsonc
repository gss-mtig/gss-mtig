{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mapa-expedicion-realtime",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "EXPEDITION_ROOM",
        "class_name": "ExpeditionRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ExpeditionRoom"]
    }
  ]
}
